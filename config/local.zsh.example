# Copy this file to ~/.config/my-perfect-zsh/local.zsh, or create one or more
# ~/.config/my-perfect-zsh/local.d/*.zsh files. The published core never stores
# machine-specific aliases, paths, credentials, or tool initialization.
#
# Local files are sourced with stdout suppressed. They may set environment
# variables, add aliases, and define functions, but the reserved keymap in
# modules/keys.zsh is applied afterwards.

# Example: prefer a private Atuin configuration over the repository defaults.
# export ATUIN_CONFIG_DIR="$XDG_CONFIG_HOME/atuin"

# Example: add a user-owned tool directory if it exists.
# if [[ -d "$HOME/.local/share/pnpm" ]]; then
#   export PNPM_HOME="$HOME/.local/share/pnpm"
#   export PATH="$PNPM_HOME/bin:$PATH"
# fi

# Example: use bat as fzf's previewer when it is installed.
# if (( $+commands[bat] )); then
#   export FZF_DEFAULT_OPTS="--preview 'bat --style=numbers --color=always --line-range :500 {}'"
# fi

# scripts/wizard writes ~/.config/my-perfect-zsh/local.d/50-wizard.zsh for four
# settings. The core module that owns each default re-applies the machine-local
# declaration after its own baseline, so these win over the published values:
#
#   history_size            HISTSIZE
#   autosuggest_highlight   ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE
#   prompt_left_elements    POWERLEVEL9K_LEFT_PROMPT_ELEMENTS
#   prompt_right_elements   POWERLEVEL9K_RIGHT_PROMPT_ELEMENTS
